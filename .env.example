# AZIZURRAHMAN — environment template
# Copy to `.env.local` for local development. Never commit real values.
# The app builds and serves its static shell with all of these empty; each value is validated
# where it is first used (see src/lib/env/). Full reference: docs/requirements/INTEGRATIONS.md

# ── Supabase (required for any database-backed page/route; Phase 2+) ─────────────────────────────
# Local values are printed by `npx supabase status` (use the API URL and the anon/publishable key).
NEXT_PUBLIC_SUPABASE_URL=
# Public by design (protected by Row Level Security). The legacy anon JWT or a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never import from
# client components. Only read in src/lib/supabase/service-role.ts. Needed from Phase 6.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────────────────────────
# Canonical origin used for metadata/absolute links. Defaults to http://localhost:3000 if empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Scheduling (Phase 5+) ────────────────────────────────────────────────────────────────────────
# Client-approved IANA timezone, e.g. Asia/Kolkata. PENDING CLIENT APPROVAL (OPEN_QUESTIONS Q7).
CONSULTATION_TIMEZONE=

# ── Optional / future-phase (server only) ────────────────────────────────────────────────────────
# Only when email notifications are approved and enabled (Phase 12).
RESEND_API_KEY=
# Only when the secure appointment lookup is implemented (Phase 7). 32+ random bytes, e.g.
# `openssl rand -base64 48`.
APPOINTMENT_LOOKUP_SECRET=
